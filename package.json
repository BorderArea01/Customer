{
  "name": "lzwcai-demp-customer",
  "version": "0.1.37",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.8.1",
  "scripts": {
    "pre": "npm run plugin:install && npm run plugin:build && npm install",
    "dev": "vite",
    "plugin:install": "node ./scripts/plugins.mjs install",
    "plugin:build": "node ./scripts/plugins.mjs build",
    "plugin:build:fresh": "node ./scripts/plugins.mjs build:fresh",
    "build": "run-s plugin:build type-check \"build-only {@}\" --",
    "build:fresh": "run-s plugin:build:fresh type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "clean": "node ./scripts/clean.mjs",
    "clean:all": "npm run clean && cd plugins/capacitor-funasr && npm run clean:cache && cd ../.. && rimraf node_modules/.vite && rimraf .vite",
    "verify:plugin": "cd plugins/capacitor-funasr && npm run build:fresh && node -e \"console.log('Plugin built successfully')\"",
    "cap:build": "npm run plugin:build && npm run build && npx cap sync",
    "cap:build:fresh": "npm run plugin:build:fresh && npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:sync:build": "npm run build-only && npm run cap:sync",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npm run build-only && npx cap run android --target=Pixel_6_Pro",
    "cap:run:android:tong": "npm run cap:build && npx cap run android --target=192.168.8.66:5555",
    "cap:run:android:vue": "npm run build-only && npx cap run android --target=192.168.8.66:5555",
    "build:android": "node ./scripts/build.mjs",
    "build:android:debug": "node ./scripts/build.mjs --debug",
    "build:android:clean": "node ./scripts/build.mjs --clean",
    "build:android:no-plugins": "node ./scripts/build.mjs --no-plugins",
    "server": "cross-env NODE_ENV=production node ./server/index.mjs",
    "server:dev": "nodemon --watch server --ext mjs,js,json --exec \"cross-env NODE_ENV=development node ./server/index.mjs\"",
    "live-update:publish": "npm run build && node ./server/publish.mjs",
    "live-update:publish:channel": "npm run build && cross-env CHANNEL=beta node ./server/publish.mjs"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^7.0.2",
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/device": "^7.0.2",
    "@capacitor/dialog": "^7.0.2",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/toast": "^7.0.2",
    "@capawesome/capacitor-live-update": "^7.2.1",
    "@types/crypto-js": "^4.2.2",
    "archiver": "^7.0.1",
    "capacitor-detection": "file:./plugins/capacitor-detection",
    "capacitor-funasr": "file:./plugins/capacitor-funasr",
    "capacitor-speech": "file:./plugins/capacitor-speech",
    "capacitor-ssdp": "file:./plugins/capacitor-ssdp",
    "chart.js": "^4.5.0",
    "cordova-plugin-apkupdater": "^5.0.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "mermaid": "^11.9.0",
    "morgan": "^1.10.1",
    "mqtt": "^5.14.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "vue": "^3.5.18",
    "vue-renderer-markdown": "^0.0.61-beta.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "nodemon": "^3.1.10",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "semver": "^7.7.2",
    "strip-json-comments": "^5.0.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vue-tsc": "^3.0.4"
  }
}
